   "source": [
    "#### Write code to replace the odd numbers by -1 in the array created by using random.randint( 1 , 50,20) "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "33dfa781-1c64-40b0-a7be-dea1f2241f1d",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "9114bee3-f9b2-46b6-ba3f-f305d9201d50",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "array([17, 33, 18, 21, 34, 40, 11,  9, 28, 33, 49, 45, 15, 44, 31, 22, 49,\n",
       "        8, 27, 49], dtype=int32)"
      ]
     },
     "execution_count": 2,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "arr = np.random.randint(1, 50, 20)\n",
    "arr"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "80a4f4f9-7216-45b6-a497-613c34c01789",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "array([-1, -1, 18, -1, 34, 40, -1, -1, 28, -1, -1, -1, -1, 44, -1, 22, -1,\n",
       "        8, -1, -1], dtype=int32)"
      ]
     },
     "execution_count": 3,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "arr[arr % 2 != 0] = -1\n",
    "arr"
   ]
  },
